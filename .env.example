# Docker and Harbor defaults
REGISTRY=registry.local
VERSION=1.0

# Backend runtime configuration
PORT=3001
NODE_ENV=development
BACKEND_API_URL=http://backend:3001

# Database configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=itcompany
DB_USER=itcompany
DB_PASSWORD=change_me

# Backend auth for admin access
ADMIN_KEY=change_this_admin_key
BACKEND_SECRET=your-secret-key-here

# PostgreSQL container seed values
POSTGRES_DB=itcompany
POSTGRES_USER=itcompany
POSTGRES_PASSWORD=change_me

